{
    "appId": "com.letta.cowork",
    "productName": "Letta Cowork",
    "files": [
        "dist-electron",
        "dist-react"
    ],
    "extraResources": [
        "dist-electron/electron/preload.cjs",
        {
            "from": "src/skills",
            "to": "skills"
        },
        {
            "from": "src/artifacts",
            "to": "artifacts"
        }
    ],
    "asarUnpack": [
        "node_modules/@letta-ai/letta-code-sdk/**/*",
        "node_modules/@letta-ai/letta-code/**/*"
    ],
    "mac": {
        "target": "dmg"
    },
    "linux": {
        "target": "AppImage",
        "category": "Utility"
    },
    "win": {
        "target": [
            "portable"
        ]
    }
}
